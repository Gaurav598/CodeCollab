# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=<app>

# Redis (local or managed)
REDIS_URL=redis://localhost:6379

# Auth
# At least 32 random bytes. JWT_SECRET must be identical in backend and sync-service.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION_DAYS=30
SERVICE_JWT_SECRET=replace-with-a-strong-service-secret
REFRESH_COOKIE_SECURE=false
BACKEND_BASE_URL=http://localhost:8080

# OAuth (leave as dummy to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Gateway
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_ORDER=gemini,openai,claude,deepseek
AI_TIMEOUT_MS=12000
AI_RATE_LIMIT_PER_MINUTE=24
AI_AUTOCOMPLETE_RATE_LIMIT_PER_MINUTE=90
AI_MAX_PROMPT_CHARS=24000
AI_MAX_CONTEXT_FILES=8

# Remote AWS Execution Engine (required for code execution feature)
EXECUTION_ENGINE_URL=https://your-aws-execution-engine.example.com
EXECUTION_ENGINE_API_KEY=
EXECUTION_DEFAULT_TIMEOUT_MS=5000
EXECUTION_MAX_TIMEOUT_MS=10000
EXECUTION_RATE_LIMIT_PER_MINUTE=30

# Frontend public URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SYNC_WS_URL=ws://localhost:1234
NEXT_PUBLIC_STOMP_WS_URL=ws://localhost:8080/api/v1/ws

# Yjs durability and authorization refresh
DOCUMENT_FLUSH_DEBOUNCE_MS=1000
DOCUMENT_FLUSH_MAX_WAIT_MS=5000
AUTHORIZATION_RECHECK_MS=30000

# Optional TURN. Prefer short-lived credentials from your TURN provider.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Browser security / cookie settings
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REFRESH_COOKIE_SECURE=false
